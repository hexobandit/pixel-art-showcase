{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",

      "Bash(node)",
      "Bash(node *)",
      "Bash(python3)",
      "Bash(python3 *)",
      "Bash(python *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(bun *)",
      "Bash(bunx *)",
      "Bash(deno *)",

      "Bash(ls)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(diff *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(tree *)",
      "Bash(env)",
      "Bash(true)",
      "Bash(false)",

      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(ln *)",
      "Bash(chmod *)",

      "Bash(open)",
      "Bash(open *)",

      "Bash(curl http://localhost*)",
      "Bash(curl http://127.0.0.1*)",
      "Bash(curl https://localhost*)",
      "Bash(curl https://127.0.0.1*)",
      "Bash(wget http://localhost*)",
      "Bash(wget http://127.0.0.1*)",

      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch -v)",
      "Bash(git branch -a)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git ls-tree*)",
      "Bash(git remote -v)",
      "Bash(git remote show*)",
      "Bash(git config --get*)",
      "Bash(git fetch*)",
      "Bash(git stash list)",
      "Bash(git stash show*)",
      "Bash(git tag)",
      "Bash(git tag -l*)",
      "Bash(git blame*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout -b*)",
      "Bash(git switch*)",
      "Bash(git restore --staged*)"
    ],
    "ask": [
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -r*)",
      "Bash(git push*)",
      "Bash(git reset*)",
      "Bash(git branch -D*)",
      "Bash(git branch -d*)",
      "Bash(git checkout --*)",
      "Bash(git restore *)",
      "Bash(git rebase*)",
      "Bash(git clean*)",
      "Bash(git commit --amend*)",
      "Bash(npm publish*)",
      "Bash(yarn publish*)",
      "Bash(pnpm publish*)"
    ],
    "deny": [
      "Bash(sudo*)",
      "Edit(/etc/**)",
      "Edit(/usr/**)",
      "Edit(/System/**)",
      "Edit(/Library/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Write(/etc/**)",
      "Write(/usr/**)",
      "Write(/System/**)",
      "Write(/Library/**)",
      "Write(~/.ssh/**)",
      "Write(~/.aws/**)",
      "Write(~/.gnupg/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)"
    ]
  }
}
